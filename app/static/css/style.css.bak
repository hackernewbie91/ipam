/* ============================================
   IPAM - Modern & Beautiful CSS
   ============================================ */

/* Import Google Font */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

/* Root Variables */
:root {
    --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --success-gradient: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
    --warning-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    --info-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    --danger-gradient: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
    --dark-gradient: linear-gradient(135deg, #2c3e50 0%, #4ca1af 100%);
    --shadow-sm: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    --shadow-md: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    --shadow-lg: 0 1rem 3rem rgba(0, 0, 0, 0.175);
    --shadow-xl: 0 1.5rem 3rem rgba(0, 0, 0, 0.2);
    --border-radius-sm: 0.5rem;
    --border-radius-md: 1rem;
    --border-radius-lg: 1.5rem;
    --transition-fast: all 0.2s ease;
    --transition-medium: all 0.3s ease;
    --transition-slow: all 0.5s ease;
}

/* Global Styles */
body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    background-attachment: fixed;
    min-height: 100vh;
    color: #2d3748;
}

/* Navbar */
.navbar {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
}

.navbar-brand {
    font-weight: 700;
    font-size: 1.5rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.navbar-nav .nav-link {
    position: relative;
    transition: var(--transition-medium);
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
}

.navbar-nav .nav-link:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
}

.navbar-nav .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--primary-gradient);
    transition: var(--transition-medium);
    transform: translateX(-50%);
}

.navbar-nav .nav-link:hover::after {
    width: 80%;
}

/* Cards */
.card {
    border: none;
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-md);
    transition: var(--transition-medium);
    overflow: hidden;
    backdrop-filter: blur(10px);
    background: rgba(255, 255, 255, 0.95);
}

.card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-5px);
}

.card-header {
    background: var(--primary-gradient) !important;
    color: white;
    font-weight: 600;
    letter-spacing: 0.5px;
    border-bottom: none;
}

/* Stat Cards */
.stat-card {
    border-radius: var(--border-radius-md);
    position: relative;
    overflow: hidden;
    transition: var(--transition-medium);
}

.stat-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    animation: pulse 3s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.1); opacity: 1; }
}

.stat-card:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: var(--shadow-xl);
}

.stat-card .card-body {
    position: relative;
    z-index: 1;
}

.stat-card .card-body h5 {
    font-size: 2.5rem;
    font-weight: 700;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
}

/* Buttons */
.btn {
    border-radius: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.3px;
    transition: var(--transition-medium);
    position: relative;
    overflow: hidden;
}

.btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.btn:hover::after {
    width: 300%;
    height: 300%;
}

.btn:active {
    transform: scale(0.95);
}

.btn-primary {
    background: var(--primary-gradient);
    border: none;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
}

.btn-primary:hover {
    background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
    transform: translateY(-2px);
}

.btn-success {
    background: var(--success-gradient);
    border: none;
    box-shadow: 0 4px 15px rgba(56, 239, 125, 0.3);
}

.btn-warning {
    background: var(--warning-gradient);
    border: none;
    box-shadow: 0 4px 15px rgba(245, 87, 108, 0.3);
}

.btn-info {
    background: var(--info-gradient);
    border: none;
    box-shadow: 0 4px 15px rgba(79, 172, 254, 0.3);
}

.btn-danger {
    background: var(--danger-gradient);
    border: none;
    box-shadow: 0 4px 15px rgba(250, 112, 154, 0.3);
}

.btn-outline-primary,
.btn-outline-success,
.btn-outline-warning,
.btn-outline-info,
.btn-outline-danger,
.btn-outline-secondary {
    border-width: 2px;
    font-weight: 600;
    transition: var(--transition-medium);
}

.btn-outline-primary:hover {
    background: var(--primary-gradient);
    border-color: transparent;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
}

.btn-outline-success:hover {
    background: var(--success-gradient);
    border-color: transparent;
}

.btn-outline-warning:hover {
    background: var(--warning-gradient);
    border-color: transparent;
}

.btn-outline-info:hover {
    background: var(--info-gradient);
    border-color: transparent;
}

.btn-outline-danger:hover {
    background: var(--danger-gradient);
    border-color: transparent;
}

/* Tables */
.table {
    border-radius: var(--border-radius-sm);
    overflow: hidden;
}

.table thead {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.table thead th {
    font-weight: 600;
    letter-spacing: 0.5px;
    border-bottom: none;
    padding: 1rem;
}

.table tbody tr {
    transition: var(--transition-fast);
}

.table tbody tr:hover {
    background: rgba(102, 126, 234, 0.05);
    transform: scale(1.001);
}

.table-striped tbody tr:nth-of-type(odd) {
    background: rgba(245, 247, 250, 0.5);
}

/* Badges */
.badge {
    padding: 0.5em 0.75em;
    font-weight: 600;
    border-radius: 0.5rem;
    letter-spacing: 0.3px;
}

.badge.bg-success {
    background: var(--success-gradient) !important;
    box-shadow: 0 2px 10px rgba(56, 239, 125, 0.3);
}

.badge.bg-danger {
    background: var(--danger-gradient) !important;
    box-shadow: 0 2px 10px rgba(250, 112, 154, 0.3);
}

.badge.bg-warning {
    background: var(--warning-gradient) !important;
    color: #fff !important;
    box-shadow: 0 2px 10px rgba(245, 87, 108, 0.3);
}

.badge.bg-info {
    background: var(--info-gradient) !important;
    box-shadow: 0 2px 10px rgba(79, 172, 254, 0.3);
}

.badge.bg-primary {
    background: var(--primary-gradient) !important;
    box-shadow: 0 2px 10px rgba(102, 126, 234, 0.3);
}

/* Progress Bars */
.progress {
    border-radius: 1rem;
    background: rgba(0, 0, 0, 0.05);
    overflow: hidden;
}

.progress-bar {
    border-radius: 1rem;
    transition: width 0.5s ease;
}

/* Forms */
.form-control {
    border-radius: 0.5rem;
    border: 2px solid #e2e8f0;
    transition: var(--transition-medium);
    padding: 0.75rem 1rem;
}

.form-control:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.2);
    transform: translateY(-1px);
}

.input-group-text {
    border-radius: 0.5rem 0 0 0.5rem;
    background: var(--primary-gradient);
    color: white;
    border: none;
}

.form-label {
    font-weight: 600;
    color: #4a5568;
    margin-bottom: 0.5rem;
}

/* Alerts */
.alert {
    border-radius: 0.75rem;
    border: none;
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(10px);
}

.alert-success {
    background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
    color: #155724;
    border-left: 4px solid #28a745;
}

.alert-danger {
    background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
    color: #721c24;
    border-left: 4px solid #dc3545;
}

.alert-warning {
    background: linear-gradient(135deg, #fff3cd 0%, #ffeeba 100%);
    color: #856404;
    border-left: 4px solid #ffc107;
}

.alert-info {
    background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
    color: #0c5460;
    border-left: 4px solid #17a2b8;
}

/* Breadcrumb */
.breadcrumb {
    background: transparent;
    padding: 0;
    margin-bottom: 1.5rem;
}

.breadcrumb-item a {
    color: #667eea;
    text-decoration: none;
    font-weight: 500;
    transition: var(--transition-fast);
}

.breadcrumb-item a:hover {
    color: #764ba2;
}

.breadcrumb-item.active {
    color: #6c757d;
    font-weight: 600;
}

/* Sidebar (Admin) */
.sidebar {
    background: rgba(255, 255, 255, 0.95);
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(10px);
}

.sidebar .nav-link {
    color: #4a5568;
    border-radius: 0.5rem;
    margin-bottom: 0.25rem;
    transition: var(--transition-medium);
    padding: 0.75rem 1rem;
}

.sidebar .nav-link:hover {
    background: var(--primary-gradient);
    color: white;
    transform: translateX(5px);
}

.sidebar .nav-link i {
    margin-right: 0.5rem;
}

/* Search Bar */
input[type="search"] {
    border-radius: 2rem !important;
    padding-left: 1.25rem !important;
    border: 2px solid #e2e8f0 !important;
    transition: var(--transition-medium) !important;
}

input[type="search"]:focus {
    border-color: #667eea !important;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.2) !important;
}

/* IP Grid / Map */
.ip-grid-cell {
    transition: var(--transition-fast);
    border-radius: 4px;
}

.ip-grid-cell:hover {
    transform: scale(1.1);
    z-index: 10;
    box-shadow: var(--shadow-md);
}

/* Animation */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.fade-in-up {
    animation: fadeInUp 0.5s ease-out;
}

/* Responsive */
@media (max-width: 768px) {
    .stat-card .card-body h5 {
        font-size: 1.8rem;
    }
    
    .navbar-brand {
        font-size: 1.2rem;
    }
    
    .table {
        font-size: 0.875rem;
    }
}

/* Scrollbar */
::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}

::-webkit-scrollbar-track {
    background: #f1f1f1;
}

::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
}